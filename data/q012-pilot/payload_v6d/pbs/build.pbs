#!/bin/bash -l
#PBS -N q012_build
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -M barry.brook@utas.edu.au
#PBS -m ae
# Build CmdStan with the observation-only sampler patch (patch/base_nuts.hpp over the pinned original, Codex 76/2066)
# and the model on a compute node, then preflight the binary (pbs/preflight.sh): log density and gradients at fixed
# points and the solver controls; a smoke run on the replay dataset; divergence capture on a forced-divergence run;
# and trace-on/off output identity (with the earlier uninstrumented binary compared where available).
# The fit job depends on this job with afterok, so any failure here stops it.
set -u
cd "${PBS_O_WORKDIR:?}" || exit 2
. ./run.env
mkdir -p build
R=build/receipt.txt
rm -f "$R" "$R.tmp"
{
  echo "host=$(hostname)"
  echo "pbs_jobid=${PBS_JOBID:-none}"
  echo "start=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$R.tmp"
fail() {
  trap - EXIT
  echo "status=failed" >> "$R.tmp"
  echo "reason=$1" >> "$R.tmp"
  echo "end=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$R.tmp"
  mv "$R.tmp" "$R"
  echo "BUILD FAILED: $1"
  exit 1
}
trap 'fail signal_TERM' TERM
trap 'fail unexpected_exit' EXIT

sha256sum -c --strict --quiet manifest.sha256 > build/manifest_check.txt 2>&1 || fail payload_manifest
sha256sum -c --strict --quiet cmdstan.sha256 > build/cmdstan_check.txt 2>&1 || fail cmdstan_tarball
echo "manifest_sha256=$(sha256sum manifest.sha256 | cut -d' ' -f1)" >> "$R.tmp"

# Lmod reads unset variables, so relax nounset around its initialisation and the module commands only.
set +u
# kunanyi's /etc/profile.d/lmod.sh returns early in batch jobs (PBS_NODEFILE set), so initialise Lmod as it
# does for login shells: the site MODULEPATH, then the OpenHPC Lmod bash init.
if ! type module > /dev/null 2>&1; then
  export MODULEPATH="${MODULEPATH:-/opt/ohpc/pub/moduledeps/gnu8:/opt/ohpc/pub/modulefiles:/share/apps/modules:/share/apps/eb-modules/all:/share/apps/moduledeps/rosalind/Core}"
  . /opt/ohpc/admin/lmod/lmod/init/bash
fi
module purge
module load "$MODULE"
rc=$?
set -u
[ "$rc" -eq 0 ] || fail module_load
echo "gxx=$(g++ --version | head -1)" >> "$R.tmp"
echo "make=$(make --version | head -1)" >> "$R.tmp"

rm -rf "cmdstan-$CMDSTAN_VERSION"
tar xzf "cmdstan-$CMDSTAN_VERSION.tar.gz" || fail cmdstan_untar
T="cmdstan-$CMDSTAN_VERSION/$PATCH_TARGET"
[ "$(sha256sum "$T" | cut -d' ' -f1)" = "$PATCH_ORIGINAL_SHA256" ] || fail patch_original_mismatch
cp patch/base_nuts.hpp "$T" || fail patch_copy
PATCH_SHA="$(sha256sum patch/base_nuts.hpp | cut -d' ' -f1)"
[ "$(sha256sum "$T" | cut -d' ' -f1)" = "$PATCH_SHA" ] || fail patch_copy_mismatch
echo "patch_target=$PATCH_TARGET" >> "$R.tmp"
echo "patch_original_sha256=$PATCH_ORIGINAL_SHA256" >> "$R.tmp"
echo "patch_sha256=$PATCH_SHA" >> "$R.tmp"
( cd "cmdstan-$CMDSTAN_VERSION" && make build -j4 ) > build/cmdstan_build.log 2>&1 || fail cmdstan_build
( cd "cmdstan-$CMDSTAN_VERSION" && make -j4 "../${MODEL_BIN#./}" ) > build/model_build.log 2>&1 || fail model_build
echo "stanc=$("cmdstan-$CMDSTAN_VERSION/bin/stanc" --version 2>&1 | head -1)" >> "$R.tmp"
echo "binary_sha256=$(sha256sum "$MODEL_BIN" | cut -d' ' -f1)" >> "$R.tmp"
grep -aq Q012_TRACE_FILE "$MODEL_BIN" || fail binary_not_instrumented
echo "binary_instrumented=yes" >> "$R.tmp"
ldd "$MODEL_BIN" > build/ldd.txt 2>&1
grep -q "not found" build/ldd.txt && fail missing_shared_libraries
echo "loaded_modules=${LOADEDMODULES:-}" >> "$R.tmp"

bash pbs/preflight.sh "$R.tmp" || fail "$(tail -1 build/preflight_reason.txt 2>/dev/null || echo preflight)"
trap - EXIT
echo "status=ok" >> "$R.tmp"
echo "end=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$R.tmp"
mv "$R.tmp" "$R"
echo "BUILD OK"
