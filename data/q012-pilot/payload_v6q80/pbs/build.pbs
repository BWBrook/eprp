#!/bin/bash -l
#PBS -N q012_build
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -M barry.brook@utas.edu.au
#PBS -m ae
# Preflight-only build job (Codex 76/2096). The quadrature order is data, so the verified instrumented binary from the
# v6d build is reused, not recompiled: its build receipt must match the pinned hash and bind this payload's patch, and
# the copied binary must match the receipt. Then pbs/preflight.sh runs against this payload's Q = 80 data and references:
# log density and gradients at fixed points, the solver controls, a smoke run, and the two capture exercises.
# The fit job depends on this job with afterok, so any failure here stops it.
set -u
cd "${PBS_O_WORKDIR:?}" || exit 2
. ./run.env
mkdir -p build
R=build/receipt.txt
rm -f "$R" "$R.tmp"
{
  echo "host=$(hostname)"
  echo "pbs_jobid=${PBS_JOBID:-none}"
  echo "start=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$R.tmp"
fail() {
  trap - EXIT
  echo "status=failed" >> "$R.tmp"
  echo "reason=$1" >> "$R.tmp"
  echo "end=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$R.tmp"
  mv "$R.tmp" "$R"
  echo "BUILD FAILED: $1"
  exit 1
}
trap 'fail signal_TERM' TERM
trap 'fail unexpected_exit' EXIT

sha256sum -c --strict --quiet manifest.sha256 > build/manifest_check.txt 2>&1 || fail payload_manifest
sha256sum -c --strict --quiet cmdstan.sha256 > build/cmdstan_check.txt 2>&1 || fail cmdstan_tarball
echo "manifest_sha256=$(sha256sum manifest.sha256 | cut -d' ' -f1)" >> "$R.tmp"

# Lmod reads unset variables, so relax nounset around its initialisation and the module commands only.
set +u
# kunanyi's /etc/profile.d/lmod.sh returns early in batch jobs (PBS_NODEFILE set), so initialise Lmod as it
# does for login shells: the site MODULEPATH, then the OpenHPC Lmod bash init.
if ! type module > /dev/null 2>&1; then
  export MODULEPATH="${MODULEPATH:-/opt/ohpc/pub/moduledeps/gnu8:/opt/ohpc/pub/modulefiles:/share/apps/modules:/share/apps/eb-modules/all:/share/apps/moduledeps/rosalind/Core}"
  . /opt/ohpc/admin/lmod/lmod/init/bash
fi
module purge
module load "$MODULE"
rc=$?
set -u
[ "$rc" -eq 0 ] || fail module_load
echo "gxx=$(g++ --version | head -1)" >> "$R.tmp"
echo "make=$(make --version | head -1)" >> "$R.tmp"

# Reuse the v6d instrumented binary, bound through its build receipt.
[ "$(sha256sum "$REUSE_BUILD_RECEIPT" 2>/dev/null | cut -d' ' -f1)" = "$REUSE_BUILD_RECEIPT_SHA256" ] || fail reuse_receipt_hash
rf() { awk -F= -v k="$1" '$1 == k { print substr($0, length(k) + 2) }' "$REUSE_BUILD_RECEIPT"; }
[ "$(rf status)" = ok ] && [ "$(rf binary_sha256)" = "$REUSE_BIN_SHA256" ] && [ "$(rf binary_instrumented)" = yes ] \
  || fail reuse_receipt_content
[ "$(rf patch_original_sha256)" = "$PATCH_ORIGINAL_SHA256" ] \
  && [ "$(rf patch_sha256)" = "$(sha256sum patch/base_nuts.hpp | cut -d' ' -f1)" ] || fail reuse_patch_binding
cp "$REUSE_BIN" "$MODEL_BIN" || fail reuse_copy
[ "$(sha256sum "$MODEL_BIN" | cut -d' ' -f1)" = "$REUSE_BIN_SHA256" ] || fail reuse_binary_hash
grep -aq Q012_TRACE_FILE "$MODEL_BIN" || fail binary_not_instrumented
{
  echo "reused_binary=$REUSE_BIN"
  echo "reused_build_receipt_sha256=$REUSE_BUILD_RECEIPT_SHA256"
  echo "reused_build_host=$(rf host)"
  echo "reused_build_gxx=$(rf gxx)"
  echo "patch_original_sha256=$(rf patch_original_sha256)"
  echo "patch_sha256=$(rf patch_sha256)"
  echo "binary_sha256=$REUSE_BIN_SHA256"
  echo "binary_instrumented=yes"
} >> "$R.tmp"
ldd "$MODEL_BIN" > build/ldd.txt 2>&1
grep -q "not found" build/ldd.txt && fail missing_shared_libraries
echo "loaded_modules=${LOADEDMODULES:-}" >> "$R.tmp"

bash pbs/preflight.sh "$R.tmp" || fail "$(tail -1 build/preflight_reason.txt 2>/dev/null || echo preflight)"
trap - EXIT
echo "status=ok" >> "$R.tmp"
echo "end=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$R.tmp"
mv "$R.tmp" "$R"
echo "BUILD OK"
