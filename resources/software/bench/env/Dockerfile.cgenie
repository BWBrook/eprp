FROM ubuntu:22.04
# Toolchain only; cGENIE.muffin code trees are mounted at $HOME/cgenie.muffin, one copy per concurrent run.
# cGENIE's makefile expects netCDF under /usr/local (NETCDF_DIR); Ubuntu installs it under /usr.
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      gfortran gcc g++ make m4 xsltproc libxml2-dev libnetcdf-dev libnetcdff-dev netcdf-bin bc \
      python3 python3-numpy python3-netcdf4 ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && ln -s /usr/lib/x86_64-linux-gnu/libnetcdf*.so* /usr/local/lib/ \
 && ln -s /usr/include/netcdf*.h /usr/include/netcdf*.mod /usr/include/typesizes.mod /usr/local/include/ \
 && ldconfig \
 && gfortran --version | head -1 > /opt/toolchain.txt \
 && nc-config --version >> /opt/toolchain.txt && nf-config --version >> /opt/toolchain.txt \
 && dpkg-query -W -f '${Package} ${Version}\n' gfortran libnetcdf-dev libnetcdff-dev xsltproc python3 >> /opt/toolchain.txt
ENV HOME=/home/cg
RUN mkdir -p /home/cg/cgenie_output && chmod -R 777 /home/cg
WORKDIR /home/cg
